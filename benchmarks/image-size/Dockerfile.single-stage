# Single-stage variant, kept to compare its size with the multi-stage app/Dockerfile.
# Drawbacks:
#   1. The compiler and headers (build-essential, libpq-dev) are needed only
#      to build psycopg2, yet they remain in the final image.
#   2. The apt and pip caches remain in the layers.
#   3. COPY . . runs before the dependency install, so any code change invalidates the pip cache.
#   4. The application runs as root.
FROM python:3.12-slim

WORKDIR /app
COPY . .

RUN apt-get update && apt-get install -y build-essential libpq-dev
RUN pip install -r requirements.txt

EXPOSE 8000
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "app:app"]
